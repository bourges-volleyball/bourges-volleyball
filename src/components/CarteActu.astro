---
import type { CollectionEntry } from "astro:content";
/* Le niveau du titre depend de la page : sous un <h2> de section sur
   l'accueil, mais directement sous le <h1> de la page Actualites. Un
   lecteur d'ecran navigue par ces niveaux, ils ne doivent pas sauter. */
interface Props {
  actu: CollectionEntry<"actus">;
  niveau?: 2 | 3;
}
const { actu, niveau = 3 } = Astro.props;
const Titre = `h${niveau}` as "h2" | "h3";
const d = actu.data.date;
---

<a class="actu" href={`/actus/${actu.id}/`}>
  {actu.data.image && (
    <img class="vignette" src={actu.data.image} alt="" width="1200" height="750" loading="lazy" />
  )}
  <time datetime={d.toISOString().slice(0, 10)}>
    {d.toLocaleDateString("fr-FR", { day: "numeric", month: "long", timeZone: "Europe/Paris" })}
  </time>
  <Titre>{actu.data.titre}</Titre>
  <p>{actu.data.chapo}</p>
</a>

<style>
  .actu {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    text-decoration: none;
  }
  /* Sans photo, un filet tient lieu d'accroche : la carte reste ancree
     en haut, et le survol la signale comme le ferait une image. */
  .actu:not(:has(.vignette)) {
    border-top: 2px solid var(--hair);
    padding-top: 0.9rem;
    transition: border-color 0.12s;
  }
  .actu:not(:has(.vignette)):hover {
    border-top-color: var(--signal);
  }
  .vignette {
    aspect-ratio: 16 / 10;
    width: 100%;
    object-fit: cover;
    border: 1px solid var(--hair);
    transition: border-color 0.12s;
  }
  .actu:hover .vignette {
    border-color: var(--signal);
  }
  time {
    font-family: "Barlow Semi Condensed", sans-serif;
    font-size: var(--s0);
    letter-spacing: 0.1em;
    color: var(--fg-2);
    font-weight: 600;
    text-transform: uppercase;
  }
  h2,
  h3 {
    font-size: 1.4rem;
  }
  p {
    margin: 0;
    color: var(--fg-2);
    font-size: 0.92rem;
  }
</style>
