---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  groupes: {
    principal: CollectionEntry<"partenaires">[];
    officiel: CollectionEntry<"partenaires">[];
    institutionnel: CollectionEntry<"partenaires">[];
  };
  titre?: string;
}
const { groupes, titre = "Partenaires" } = Astro.props;

const niveaux = [
  { cle: "principal", libelle: "Partenaire principal", liste: groupes.principal },
  { cle: "officiel", libelle: "Partenaires officiels", liste: groupes.officiel },
  { cle: "institutionnel", libelle: "Institutionnels", liste: groupes.institutionnel },
] as const;
---

<section class="section partenaires" id="partenaires">
  <div class="wrap">
    <div class="section-head">
      <h2>{titre}</h2>
      <a class="lien" href="/partenaires/">Devenir partenaire</a>
    </div>

    {
      groupes.principal.length === 0 && (
        <div class="tier">
          <h3>Partenaire principal</h3>
          <a class="libre" href="/partenaires/">
            <span class="libre-titre">Cet emplacement est libre</span>
            <span class="libre-detail">
              Logo sur les maillots et la banderole du gymnase &mdash;
              devenir partenaire
            </span>
          </a>
        </div>
      )
    }

    {
      niveaux.map(
        (n) =>
          n.liste.length > 0 && (
            <div class="tier">
              <h3>{n.libelle}</h3>
              <div class:list={["tier-row", n.cle === "principal" ? "main" : "four"]}>
                {n.liste.map((p) => {
                  const contenu = p.data.logo ? (
                    <Image src={p.data.logo} alt={p.data.nom} height={110} densities={[1, 2]} />
                  ) : (
                    p.data.nom
                  );
                  /* Un partenaire dont le site est renseigne devient cliquable.
                     Il ouvre dans un nouvel onglet : le visiteur ne perd pas
                     le site du club. La mention entre parenthèses n'est lue
                     que par les lecteurs d'ecran, qui sans cela n'annoncent
                     pas le changement de fenetre. */
                  return p.data.lien ? (
                    <a
                      class="plogo"
                      href={p.data.lien}
                      target="_blank"
                      rel="noopener"
                      title={`Site de ${p.data.nom}`}
                    >
                      {contenu}
                      <span class="hors-ecran"> (nouvelle fenêtre)</span>
                    </a>
                  ) : (
                    <div class="plogo">{contenu}</div>
                  );
                })}
              </div>
            </div>
          ),
      )
    }
  </div>
</section>

<style>
  /* Même charte que le reste du site : fond sombre, pas de bande claire. */
  .partenaires {
    border-top: 1px solid var(--hair);
  }
  .tier {
    margin-top: 1.2rem;
  }
  .tier h3 {
    font-family: "Barlow Semi Condensed", sans-serif;
    font-weight: 600;
    font-size: var(--s0);
    letter-spacing: 0.14em;
    color: var(--fg-2);
    text-transform: uppercase;
  }
  .tier-row {
    display: grid;
    gap: 1px;
    background: var(--hair);
    border: 1px solid var(--hair);
    margin-top: 0.6rem;
  }
  .tier-row.main {
    grid-template-columns: 1fr;
  }
  .tier-row.four {
    grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
  }
  /* Un emplacement a pourvoir ne doit pas ressembler a un partenaire :
     trait discontinu, texte en retrait, pas de fond plein. */
  .libre {
    display: grid;
    place-content: center;
    text-align: center;
    gap: 0.4rem;
    padding: 2rem 1rem;
    margin-top: 0.6rem;
    border: 1px dashed var(--hair);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .libre:hover,
  .libre:focus-visible {
    border-color: var(--signal);
  }
  .libre-titre {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    color: var(--fg-2);
  }
  .libre:hover .libre-titre {
    color: var(--fg);
  }
  .libre-detail {
    font-family: "Barlow Semi Condensed", sans-serif;
    font-size: var(--s0);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .plogo {
    background: var(--noir-2);
    display: grid;
    place-content: center;
    text-align: center;
    padding: 1.4rem 1rem;
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 1.2rem;
    line-height: 1;
    color: var(--fg);
    text-decoration: none;
    min-height: 92px;
    transition: background 0.12s;
  }
  /* Les logos d'entreprises sont dessinés pour du fond blanc. Plutôt qu'une
     bande claire, on les ramène tous en blanc plein : la paroi de sponsors
     devient homogène. Les vraies couleurs reviennent au survol. */
  .plogo img {
    max-height: 64px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.75;
    transition:
      filter 0.15s,
      opacity 0.15s;
  }
  .plogo:hover img {
    filter: none;
    opacity: 1;
  }
  a.plogo:hover {
    background: var(--noir-3);
  }
  /* Un partenaire cliquable doit se voir comme tel */
  a.plogo:hover,
  a.plogo:focus-visible {
    color: var(--signal);
  }
  .hors-ecran {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .tier-row.main .plogo {
    padding-block: 2.4rem;
    font-size: clamp(1.7rem, 4.5vw, 2.4rem);
    font-weight: 800;
  }
  .tier-row.main .plogo img {
    max-height: 110px;
    opacity: 0.9;
  }
</style>
