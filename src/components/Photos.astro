---
/* Photos en grille ; chacune s'ouvre en grand d'un clic. Fleches du clavier
   ou boutons pour passer a la suivante, Echap pour fermer. Mode diaporama :
   les photos defilent seules, en plein ecran quand le navigateur le permet
   (pas sur iPhone). Un bouton [data-diaporama] place ailleurs dans la page
   lance le diaporama depuis la premiere photo.
   Sert aux albums de la galerie et aux photos d'une actualite : une seule
   grille par page. */
import { Image, getImage } from "astro:assets";

interface Props {
  photos: { photo: ImageMetadata; legende?: string }[];
}
const { photos } = Astro.props;
// Version agrandie, ouverte d'un clic : jamais plus grande que l'original
const grandes = await Promise.all(
  photos.map((p) => getImage({ src: p.photo, width: Math.min(1800, p.photo.width), format: "webp" })),
);
---

<ul class="photos">
  {
    photos.map((p, i) => (
      <li>
        <button type="button" class="vignette" data-i={i} data-grande={grandes[i].src} data-legende={p.legende ?? ""} aria-label={`Agrandir la photo ${i + 1}${p.legende ? ` : ${p.legende}` : ""}`}>
          <Image src={p.photo} alt={p.legende ?? ""} widths={[320, 640, 900]} sizes="(min-width: 1100px) 25vw, (min-width: 640px) 33vw, 50vw" loading={i < 8 ? "eager" : "lazy"} />
        </button>
      </li>
    ))
  }
</ul>

<dialog class="visionneuse" data-visionneuse aria-label="Photo agrandie">
  <img alt="" />
  <p class="legende"></p>
  <div class="boutons">
    <button type="button" class="btn ghost" data-pas="-1" aria-label="Photo précédente"><span>←</span></button>
    <span class="compteur"></span>
    <button type="button" class="btn ghost" data-pas="1" aria-label="Photo suivante"><span>→</span></button>
    <button type="button" class="btn ghost" data-lecture aria-pressed="false"><span>▶ Diaporama</span></button>
    <button type="button" class="btn" data-fermer><span>Fermer</span></button>
  </div>
</dialog>

<script>
  const visionneuse = document.querySelector<HTMLDialogElement>("[data-visionneuse]");
  const vignettes = [...document.querySelectorAll<HTMLButtonElement>(".vignette")];
  if (visionneuse && vignettes.length) {
    const img = visionneuse.querySelector("img")!;
    const lecture = visionneuse.querySelector<HTMLButtonElement>("[data-lecture]")!;
    const DUREE = 4000; // temps de chaque photo en diaporama, en millisecondes
    let courante = 0;
    let minuteur: ReturnType<typeof setInterval> | undefined;

    // Fondu a chaque photo (coupe si le visiteur a demande moins d'animations)
    const prete = () => img.classList.add("prete");
    img.addEventListener("load", prete);
    img.addEventListener("error", prete);

    const montrer = (i: number) => {
      courante = (i + vignettes.length) % vignettes.length;
      const v = vignettes[courante];
      img.classList.remove("prete");
      img.src = v.dataset.grande!;
      if (img.complete) prete();
      img.alt = v.dataset.legende!;
      visionneuse.querySelector(".legende")!.textContent = v.dataset.legende!;
      visionneuse.querySelector(".compteur")!.textContent = `${courante + 1} / ${vignettes.length}`;
      // La suivante se charge pendant qu'on regarde celle-ci
      new Image().src = vignettes[(courante + 1) % vignettes.length].dataset.grande!;
    };

    const lire = (oui: boolean) => {
      clearInterval(minuteur);
      minuteur = oui ? setInterval(() => montrer(courante + 1), DUREE) : undefined;
      lecture.setAttribute("aria-pressed", String(oui));
      lecture.firstElementChild!.textContent = oui ? "❚❚ Pause" : "▶ Diaporama";
    };
    // Une photo choisie a la main reste affichee le temps complet
    const aLaMain = (i: number) => {
      montrer(i);
      if (minuteur !== undefined) lire(true);
    };

    vignettes.forEach((v, i) => v.addEventListener("click", () => (montrer(i), visionneuse.showModal())));
    document.querySelector("[data-diaporama]")?.addEventListener("click", () => {
      const ouvrir = () => {
        montrer(0);
        visionneuse.showModal();
        lire(true);
      };
      // Le plein ecran d'abord, la visionneuse ensuite : ouverte avant, elle
      // passerait sous la page. Refuse ou absent (iPhone) : sans plein ecran.
      const pleinEcran = document.documentElement.requestFullscreen?.();
      if (pleinEcran) pleinEcran.then(ouvrir, ouvrir);
      else ouvrir();
    });
    visionneuse.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button");
      if (b?.dataset.pas) aLaMain(courante + Number(b.dataset.pas));
      else if (b === lecture) lire(minuteur === undefined);
      else if (b?.hasAttribute("data-fermer") || e.target === visionneuse) visionneuse.close();
    });
    visionneuse.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") aLaMain(courante + 1);
      if (e.key === "ArrowLeft") aLaMain(courante - 1);
    });
    // Fermer arrete le diaporama et quitte le plein ecran
    visionneuse.addEventListener("close", () => {
      lire(false);
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
    });
    // Une seule photo : pas de precedente, de suivante ni de diaporama
    if (vignettes.length === 1) visionneuse.querySelectorAll<HTMLElement>("[data-pas], [data-lecture], .compteur").forEach((e) => (e.hidden = true));
  }
</script>

<style>
  .photos {
    list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(45%, 240px), 1fr));
  }
  .vignette {
    display: block; width: 100%; aspect-ratio: 1; padding: 0; border: 0; cursor: zoom-in;
    background: var(--noir-2); overflow: hidden;
  }
  /* Vignette carree : 30 % garde les tetes sur une photo prise en hauteur */
  .vignette :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; transition: transform 0.3s ease; }
  .vignette:hover :global(img) { transform: scale(1.05); }

  .visionneuse {
    border: 0; padding: 1rem; background: var(--noir-2); color: var(--fg);
    max-width: min(96vw, 1400px); text-align: center;
  }
  .visionneuse::backdrop { background: rgba(9, 10, 13, 0.9); }
  .visionneuse img { display: block; margin: 0 auto; max-width: 100%; max-height: 78vh; object-fit: contain; opacity: 0; transition: opacity 0.35s ease; }
  .visionneuse img.prete { opacity: 1; }
  /* Plein ecran du diaporama : fond noir, la page disparait */
  :global(html:fullscreen) .visionneuse::backdrop { background: #090a0d; }
  .legende { margin: 0.8rem 0 0; font-weight: 600; min-height: 1.6em; }
  .boutons { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.75rem; margin-top: 0.8rem; }
  .boutons [hidden] { display: none; }
  .compteur { font-family: "Barlow Semi Condensed", sans-serif; letter-spacing: 0.1em; color: var(--fg-2); min-width: 4rem; }
  button.btn { cursor: pointer; font-family: "Barlow Semi Condensed", sans-serif; }
</style>
