---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  titre?: string;
  description?: string;
  image?: string;
}

const { titre, description, image = "/images/hero/hero-1.jpg" } = Astro.props;

const NOM = "Bourges Volley-Ball";
const titreComplet = titre ? `${titre} — ${NOM}` : `${NOM} — club de volley à Bourges`;
const desc =
  description ??
  "Club de volley-ball à Bourges (Cher). Prénationale masculine, régionale féminine, jeunes de M13 à M18 et section loisir Ufolep.";

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Donnees structurees : c'est ce qui permet a Google d'afficher le club
// comme une organisation sportive locale plutot qu'une page ordinaire.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SportsClub",
  name: NOM,
  sport: "Volleyball",
  url: Astro.site?.toString(),
  email: "bourgesvolley@gmail.com",
  telephone: "+33666782802",
  address: {
    "@type": "PostalAddress",
    streetAddress: "33 rue du 1er Régiment d'Artillerie",
    postalCode: "18000",
    addressLocality: "Bourges",
    addressCountry: "FR",
  },
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/logo-bvb.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NOM} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Barlow+Semi+Condensed:wght@500;600&family=Barlow:wght@400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />

    <!-- Quand un benevole clique sur son lien d invitation, Netlify le renvoie
         sur la page d accueil : ce script le conduit a l administration. -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", (user) => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
  </body>
</html>
