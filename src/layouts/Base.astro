---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ogDefaut from "../images/hero/hero-1.jpg";

interface Props {
  titre?: string;
  description?: string;
  image?: string;
}

const { titre, description, image = ogDefaut.src } = Astro.props;

const NOM = "Bourges Volley-Ball";
const titreComplet = titre ? `${titre} — ${NOM}` : `${NOM} — club de volley à Bourges`;
const desc =
  description ??
  "Club de volley-ball à Bourges (Cher). Prénationale masculine, régionale féminine, jeunes de M13 à M18 et section loisir Ufolep.";

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Donnees structurees : c'est ce qui permet a Google d'afficher le club
// comme une organisation sportive locale plutot qu'une page ordinaire.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SportsClub",
  name: NOM,
  sport: "Volleyball",
  url: Astro.site?.toString(),
  email: "bourgesvolley@gmail.com",
  telephone: "+33666782802",
  address: {
    "@type": "PostalAddress",
    streetAddress: "33 rue du 1er Régiment d'Artillerie",
    postalCode: "18000",
    addressLocality: "Bourges",
    addressCountry: "FR",
  },
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/logo-bvb.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NOM} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Barlow+Semi+Condensed:wght@500;600&family=Barlow:wght@400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />

    <!-- Quand un benevole clique sur son lien d invitation, Netlify le renvoie
         sur la page d accueil avec un jeton dans l'adresse. Ce script le
         conduit alors a l'administration.

         Le widget n'est charge QUE dans ce cas. Auparavant il l'etait sur
         chaque page, pour chaque visiteur : une requete vers un service
         exterieur, sur toutes les pages, pour un evenement qui concerne
         une poignee de personnes deux fois par an. -->
    <script is:inline>
      (function () {
        var jeton = /(invite_token|recovery_token|confirmation_token|email_change_token)=/;
        if (!jeton.test(window.location.hash)) return;

        var s = document.createElement("script");
        s.src = "https://identity.netlify.com/v1/netlify-identity-widget.js";
        s.onload = function () {
          if (!window.netlifyIdentity) return;

          // Netlify connecte le benevole sans rien lui dire : il se
          // retrouve sur la page d accueil sans savoir si ca a marche.
          // On le lui dit, et on lui donne la porte.
          window.netlifyIdentity.on("login", function () {
            window.netlifyIdentity.close();
            var recuperation = /recovery_token=/.test(window.location.hash);
            var voile = document.createElement("div");
            voile.setAttribute("role", "status");
            voile.style.cssText =
              "position:fixed;inset:0;z-index:9999;display:grid;place-items:center;" +
              "padding:var(--pad);background:rgba(13,14,17,.985);text-align:center";
            voile.innerHTML =
              '<div style="display:grid;gap:1.15rem;justify-items:center;max-width:40ch">' +
              '<p class="eyebrow">Bourges Volley-Ball</p>' +
              '<h2 style="font-size:clamp(2rem,6vw,2.8rem)">' +
              (recuperation
                ? 'Nouveau mot de passe enregistré'
                : 'Votre compte est prêt') +
              '</h2>' +
              '<p style="color:var(--fg-2);margin:0">Vous êtes connecté. Vous pouvez désormais écrire une actualité ou mettre à jour une page, et revenir quand vous voulez par la même adresse.</p>' +
              '<a class="btn" href="/admin/"><span>Ouvrir l&rsquo;administration</span></a>' +
              '<a class="lien" href="/">Retour au site</a>' +
              '</div>';
            document.body.appendChild(voile);
            var porte = voile.querySelector("a.btn");
            if (porte) porte.focus();
          });

          // init() doit etre appele explicitement : le widget ne
          // s initialise seul que s il est present au chargement de la
          // page, ce qui n est pas le cas ici puisqu on l ajoute apres.
          window.netlifyIdentity.init();
        };
        document.head.appendChild(s);
      })();
    </script>
  </body>
</html>
