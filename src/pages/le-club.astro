---
import Base from "../layouts/Base.astro";
import { getEntry } from "astro:content";

/* Tous les textes de cette page se modifient dans l'administration,
   rubrique « Textes des pages » : src/content/pages/le-club.md. */
const { surtitre, intro, chiffres, histoire, palmares, notePalmares } = (await getEntry("pageClub", "le-club"))!.data;
---

<Base
  titre="Le club"
  description="Histoire et palmarès du Bourges Volley-Ball : de l’US Berry Volley-Ball au BVB, deux Coupes de France Ufolep et un titre de champion de prénationale."
>
  <section class="page-head wrap">
    <p class="eyebrow">{surtitre}</p>
    <h1>Le club</h1>
    <p>{intro}</p>
  </section>

  <section class="section wrap">
    <ul class="chiffres">
      {
        chiffres.map((c) => (
          <li>
            <b>{c.valeur}</b>
            <span>{c.legende}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap">
    <div class="section-head"><h2>Notre histoire</h2></div>
    <ol class="frise">
      {
        histoire.map((e) => (
          <li>
            <p class="quand">{e.date}</p>
            <h3>{e.titre}</h3>
            <p class="texte">{e.texte}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section wrap">
    <div class="section-head"><h2>Palmarès</h2></div>
    <ul class="palmares">
      {
        palmares.map((p) => (
          <li>
            <span class="annee mono">{p.annee}</span>
            <span class="quoi">
              <b>{p.titre}</b>
              <span class="detail">{p.detail}</span>
            </span>
          </li>
        ))
      }
    </ul>
    {notePalmares && <p class="note">{notePalmares}</p>}
  </section>

  <section class="section wrap appel">
    <h2>Venir jouer</h2>
    <p>
      Le club accueille des débutants à tout âge, en compétition comme en loisir.
      Deux séances d’essai gratuites avant de prendre la licence.
    </p>
    <a class="btn" href="/nous-rejoindre/"><span>Nous rejoindre</span></a>
  </section>
</Base>

<style>
  .chiffres {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 1px; background: var(--hair);
    border: 1px solid var(--hair);
  }
  @media (min-width: 640px) { .chiffres { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .chiffres { grid-template-columns: repeat(4, 1fr); } }
  .chiffres li {
    background: var(--noir-2);
    padding: clamp(1.1rem, 3vw, 1.6rem);
  }
  .chiffres b {
    display: block;
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 800;
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .chiffres span {
    font-family: "Barlow Semi Condensed", sans-serif;
    font-size: var(--s0);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  /* Frise : ici l'ordre porte une information reelle, le club a bien
     traverse ces etapes dans cet ordre. */
  .frise { list-style: none; padding: 0; margin: 0; display: grid; }
  .frise li {
    padding: 1.4rem 0 1.4rem 1.5rem;
    border-top: 1px solid var(--hair);
    border-left: 2px solid var(--hair);
    position: relative;
  }
  .frise li:first-child { border-top: 2px solid var(--structure); }
  .frise li::before {
    content: "";
    position: absolute;
    left: -6px;
    top: 1.8rem;
    width: 10px;
    height: 10px;
    background: var(--signal);
  }
  .quand {
    margin: 0 0 0.3rem;
    font-family: "Barlow Semi Condensed", sans-serif;
    font-weight: 600;
    font-size: var(--s0);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-2);
  }
  .frise h3 { font-size: 1.6rem; }
  .texte { margin: 0.5rem 0 0; color: var(--fg-2); max-width: 66ch; }

  .palmares { list-style: none; padding: 0; margin: 0; display: grid; }
  .palmares li {
    display: grid;
    gap: 0.2rem 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--hair);
    align-items: baseline;
  }
  .palmares li:first-child { border-top: 2px solid var(--structure); }
  @media (min-width: 640px) { .palmares li { grid-template-columns: 8rem 1fr; } }
  .annee {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 800;
    font-size: 1.5rem;
    /* Un titre gagne : c'est exactement ce que le vert signale */
    color: var(--signal);
  }
  .quoi b {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 1.35rem;
    display: block;
  }
  .detail { color: var(--fg-2); font-size: 0.94rem; }
  .note { margin-top: 1.25rem; color: var(--fg-2); font-size: 0.9rem; }

  .appel { border-top: 1px solid var(--hair); display: grid; gap: 0.9rem; justify-items: start; }
  .appel h2 { font-size: clamp(1.8rem, 5vw, 2.6rem); }
  .appel p { margin: 0; color: var(--fg-2); max-width: 60ch; }
</style>
