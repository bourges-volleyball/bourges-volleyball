---
/* Netlify sert ce fichier automatiquement pour toute adresse inconnue.
   Rien à configurer : il suffit qu'il s'appelle 404. */
import Base from "../layouts/Base.astro";

const PISTES = [
  { href: "/", titre: "Accueil", texte: "Les actualités et le prochain match" },
  { href: "/equipes/", titre: "Les équipes", texte: "Du M13 aux seniors, et la section loisir" },
  { href: "/matchs/", titre: "Matchs et résultats", texte: "Le calendrier de toutes les équipes" },
  { href: "/agenda/", titre: "Agenda", texte: "Tournois, stages, vie du club" },
  { href: "/nous-rejoindre/", titre: "Nous rejoindre", texte: "Les créneaux, les tarifs, l'essai gratuit" },
  { href: "/contact/", titre: "Contact", texte: "Nous écrire ou nous appeler" },
];
---

<Base
  titre="Page introuvable"
  description="Cette page n'existe pas ou n'existe plus."
>
  <section class="page-head wrap">
    <p class="eyebrow">Erreur 404</p>
    <h1>Balle <span class="out">dehors</span></h1>
    <p>
      Cette page n&rsquo;existe pas, ou n&rsquo;existe plus. Si vous arrivez
      par un ancien lien, c&rsquo;est normal : le site du club a changé
      d&rsquo;adresse. Voici par où reprendre.
    </p>
  </section>

  <section class="section wrap">
    <ul class="pistes">
      {
        PISTES.map((p) => (
          <li>
            <a href={p.href}>
              <span class="titre">{p.titre}</span>
              <span class="texte">{p.texte}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  /* Même traitement que le mot "ici" du titre d'accueil */
  .out {
    position: relative;
    display: inline-block;
    color: var(--signal);
    font-style: italic;
  }
  .out::after {
    content: "";
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: 0.05em;
    height: 0.09em;
    background: var(--signal);
    transform: skewX(-14deg);
  }

  .pistes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1px;
    background: var(--hair);
    border: 1px solid var(--hair);
  }
  @media (min-width: 640px) {
    .pistes { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .pistes { grid-template-columns: repeat(3, 1fr); }
  }
  .pistes a {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    height: 100%;
    padding: 1.15rem 1.25rem;
    background: var(--noir-2);
    text-decoration: none;
    transition: background 0.12s, color 0.12s;
  }
  .pistes a:hover { background: var(--noir-3); }
  .titre {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 1.5rem;
    line-height: 1.05;
  }
  .pistes a:hover .titre { color: var(--signal); }
  .texte { color: var(--fg-2); font-size: var(--s1); }
</style>
