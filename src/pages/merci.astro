---
/* Page affichee apres l'envoi du formulaire de contact (action="/merci/").
   Sans elle, Netlify affiche sa propre page, en anglais. */
import Base from "../layouts/Base.astro";
---

<Base titre="Message envoyé" description="Votre message a bien été envoyé au Bourges Volley-Ball.">
  <section class="page-head wrap">
    <p class="eyebrow">Contact</p>
    <h1>Message envoyé</h1>
    <p>
      Merci, votre message est bien parti. Un bénévole du club vous répond
      sous quelques jours, à l&rsquo;adresse que vous avez indiquée.
    </p>
    <p class="suite">
      <a class="btn" href="/"><span>Retour à l&rsquo;accueil</span></a>
      <a class="btn ghost" href="/nous-rejoindre/"><span>Voir les créneaux</span></a>
    </p>
  </section>
</Base>

<style>
  .suite { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.5rem; }
</style>
