---
import Base from "../../layouts/Base.astro";
import { render } from "astro:content";
import { Image, getImage } from "astro:assets";
import { actus } from "../../lib/donnees";

export async function getStaticPaths() {
  const liste = await actus();
  return liste.map((a) => ({ params: { id: a.id }, props: { actu: a } }));
}

const { actu } = Astro.props;
const { Content } = await render(actu);
const d = actu.data.date;
const autres = (await actus()).filter((a) => a.id !== actu.id).slice(0, 3);

const img = actu.data.image;
// Partage sur les reseaux : un JPEG de 1200 px, format que tous acceptent
const partage = img && (await getImage({ src: img, width: Math.min(1200, img.width), format: "jpg" }));
// Affiche ouverte en grand : WebP pleine definition (plafonnee a 2400 px)
const grande = img && actu.data.affiche && (await getImage({ src: img, width: Math.min(2400, img.width), format: "webp" }));
---

<Base titre={actu.data.titre} description={actu.data.chapo} image={partage?.src}>
  <article>
    <div class="page-head wrap">
      <p class="eyebrow">
        <time datetime={d.toISOString().slice(0, 10)}>
          {d.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric", timeZone: "Europe/Paris" })}
        </time>
      </p>
      <h1>{actu.data.titre}</h1>
      <p>{actu.data.chapo}</p>
    </div>

    {
      actu.data.image && !actu.data.affiche && (
        <figure class="une">
          <Image src={img!} alt="" widths={[640, 960, 1280, 1600, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
        </figure>
      )
    }
    {
      actu.data.image && actu.data.affiche && (
        <figure class="affiche-entiere wrap">
          <a href={grande!.src} target="_blank" rel="noopener">
            <Image src={img!} alt={`Affiche : ${actu.data.titre}`} widths={[480, 800, 1200]} sizes="(min-width: 900px) 800px, 100vw" />
          </a>
          <figcaption>Cliquer sur l&rsquo;affiche pour l&rsquo;ouvrir en grand</figcaption>
        </figure>
      )
    }

    <div class="corps wrap"><Content /></div>
  </article>

  {
    autres.length > 0 && (
      <section class="section wrap suite">
        <div class="section-head">
          <h2>Autres actualités</h2>
          <a class="lien" href="/actus/">Toutes les actus</a>
        </div>
        <ul class="autres">
          {autres.map((a) => (
            <li><a href={`/actus/${a.id}/`}>{a.data.titre}</a></li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .une { margin: 0; }
  .une img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; }
  /* Une affiche se lit en entier : pas de bandeau recadre, mais l'image
     a sa taille naturelle, bornee a la hauteur de l'ecran. */
  .affiche-entiere { margin: 0 auto; display: grid; justify-items: center; gap: 0.6rem; }
  .affiche-entiere a { display: block; cursor: zoom-in; }
  .affiche-entiere img {
    display: block;
    max-height: 85vh;
    width: auto;
    height: auto;
    max-width: 100%;
    border: 1px solid var(--hair);
    transition: border-color 0.12s;
  }
  .affiche-entiere a:hover img { border-color: var(--signal); }
  .affiche-entiere figcaption {
    font-family: "Barlow Semi Condensed", sans-serif;
    font-size: var(--s0);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-2);
  }
  .corps {
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    max-width: 68ch; font-size: var(--s2);
  }
  .corps :global(h2) { font-size: 1.9rem; margin-top: 2rem; }
  .corps :global(h3) { font-size: 1.5rem; margin-top: 1.5rem; }
  .corps :global(p) { margin: 1rem 0; }
  .corps :global(a) { color: var(--signal); }
  .corps :global(ul), .corps :global(ol) { padding-left: 1.2rem; }
  .corps :global(li) { margin: 0.4rem 0; }
  .corps :global(img) { width: 100%; }
  /* Les tableaux (creneaux, tarifs) debordent sur telephone :
     on les rend defilables plutot que de casser la mise en page. */
  .corps :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: var(--s1);
  }
  .corps :global(th) {
    text-align: left;
    font-family: "Barlow Semi Condensed", sans-serif;
    font-size: var(--s0);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-2);
    font-weight: 600;
  }
  .corps :global(th),
  .corps :global(td) {
    border-bottom: 1px solid var(--hair);
    padding: 0.6rem 1rem 0.6rem 0;
    vertical-align: top;
  }
  .corps :global(tbody tr:hover) { background: var(--noir-2); }

  .corps :global(blockquote) {
    margin: 1.5rem 0; padding-left: 1rem;
    border-left: 3px solid var(--signal); color: var(--fg-2);
  }
  .suite { border-top: 1px solid var(--hair); }
  .autres { list-style: none; padding: 0; margin: 0; display: grid; }
  .autres li { border-top: 1px solid var(--hair); }
  .autres li:first-child { border-top: 0; }
  .autres a {
    display: block; padding: 0.9rem 0; text-decoration: none;
    font-family: "Barlow Condensed", sans-serif; font-weight: 800;
    text-transform: uppercase; font-size: 1.4rem; transition: color 0.12s;
  }
  .autres a:hover { color: var(--signal); }
</style>
