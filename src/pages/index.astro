---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Portes from "../components/Portes.astro";
import BandeMatch from "../components/BandeMatch.astro";
import BandePartenaires from "../components/BandePartenaires.astro";
import { Image } from "astro:assets";
import { matchs, actus, partenaires, agenda, albums, dateLongue, heure, FUSEAU } from "../lib/donnees";

const { aVenir, joues } = await matchs();
const dernieresActus = await actus(3);
const groupes = await partenaires();
const rendezvous = await agenda(10);

/* Dernier album de la galerie : une grande photo et quelques petites. 5 ou 3
   photos selon ce que l'album contient, pour que la mosaique tombe juste. */
const [album] = await albums(1);
const nbPhotos = album?.data.photos.length ?? 0;
const mosaique = album?.data.photos.slice(0, nbPhotos >= 5 ? 5 : nbPhotos >= 3 ? 3 : nbPhotos) ?? [];
---

<Base>
  <Hero actus={dernieresActus} />


  <Portes />
  <BandeMatch aVenir={aVenir.slice(0, 15)} resultats={joues.slice(0, 3)} />

  {
    rendezvous.length > 0 && (
      <section class="section wrap" id="agenda">
        <div class="section-head">
          <h2>Prochains rendez-vous</h2>
          <a class="lien" href="/agenda/">Tout l&rsquo;agenda</a>
        </div>
        <ol class="rdv" data-max="4">
          {rendezvous.map((r) => (
            <li data-jusqua={r.jusqua.toISOString()}>
              <span class="rdv-date">
                <b>{dateLongue(r.date)}</b>
                {r.avecHeure && !r.dateFin && <span class="mono">{heure(r.date)}</span>}
              </span>
              <span class="rdv-titre">
                {r.titre}
                <span class="rdv-cat">{r.categorie}</span>
              </span>
              {r.lieu && <span class="rdv-lieu">{r.lieu}</span>}
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    album && (
      <section class="section wrap" id="photos">
        <div class="section-head">
          <h2>Dernières photos</h2>
          <a class="lien" href="/galerie/">Toute la galerie</a>
        </div>
        <a class="album" href={`/galerie/${album.id}/`}>
          <span class="mosaique" data-n={mosaique.length}>
            {mosaique.map((p, i) => (
              <Image
                src={p.photo}
                alt=""
                widths={i === 0 ? [500, 800, 1200] : [300, 500]}
                sizes={i === 0 ? "(min-width: 760px) 50vw, 100vw" : "(min-width: 760px) 25vw, 50vw"}
                loading="lazy"
              />
            ))}
          </span>
          <span class="album-texte">
            <span class="album-date">
              {album.data.date.toLocaleDateString("fr-FR", { month: "long", year: "numeric", timeZone: FUSEAU })} · {nbPhotos} photo{nbPhotos > 1 ? "s" : ""}
            </span>
            <span class="album-titre">{album.data.titre}</span>
            <span class="album-voir">Voir l&rsquo;album</span>
          </span>
        </a>
      </section>
    )
  }

  <BandePartenaires groupes={groupes} />
</Base>

<style>
  /* Dernieres photos : mobile, la grande en haut et les petites deux par deux ;
     a partir de 760 px, la grande a gauche sur deux rangees. */
  .album { display: grid; gap: 1rem; text-decoration: none; }
  .mosaique { display: grid; gap: 0.5rem; grid-template-columns: 1fr 1fr; }
  .mosaique :global(img) { width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; transition: opacity 0.2s; }
  .mosaique :global(img:first-child) { grid-column: 1 / -1; }
  .mosaique[data-n="1"] { grid-template-columns: 1fr; }
  .mosaique[data-n="2"] :global(img:first-child) { grid-column: auto; }
  .album:hover .mosaique :global(img) { opacity: 0.85; }
  @media (min-width: 760px) {
    .mosaique { grid-template-rows: repeat(2, clamp(150px, 15vw, 230px)); }
    .mosaique :global(img) { aspect-ratio: auto; }
    .mosaique[data-n="5"] { grid-template-columns: 2fr 1fr 1fr; }
    .mosaique[data-n="3"] { grid-template-columns: 2fr 1fr; }
    .mosaique[data-n="2"] { grid-template-columns: 1fr 1fr; }
    .mosaique :global(img:first-child) { grid-column: auto; grid-row: span 2; }
    .mosaique[data-n="2"] :global(img) { grid-row: span 2; }
  }
  .album-texte { display: grid; gap: 0.3rem; justify-items: start; }
  .album-date {
    font-family: "Barlow Semi Condensed", sans-serif; font-weight: 600; font-size: var(--s0);
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--signal);
  }
  .album-titre {
    font-family: "Barlow Condensed", sans-serif; font-weight: 800; text-transform: uppercase;
    font-size: clamp(1.4rem, 3vw, 1.9rem); line-height: 1;
  }
  .album-voir {
    font-family: "Barlow Semi Condensed", sans-serif; font-weight: 600; font-size: var(--s0);
    letter-spacing: 0.1em; text-transform: uppercase; border-bottom: 2px solid var(--signal); padding-bottom: 0.1rem;
  }
  .album:hover .album-voir { color: var(--signal); }

  .rdv { list-style: none; padding: 0; margin: 0; display: grid; }
  .rdv li {
    display: grid;
    gap: 0.15rem 1.5rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--hair);
    align-items: baseline;
  }
  .rdv li:first-child { border-top: 2px solid var(--structure); }
  @media (min-width: 760px) {
    .rdv li { grid-template-columns: 14rem 1fr auto; }
  }
  .rdv-date b {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 1.15rem;
    margin-right: 0.5rem;
  }
  .rdv-date .mono {
    font-size: var(--s0);
    letter-spacing: 0.1em;
    color: var(--fg-2);
  }
  .rdv-titre { font-weight: 600; }
  .rdv-cat {
    display: block;
    font-family: "Barlow Semi Condensed", sans-serif;
    font-weight: 600;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-2);
    margin-top: 0.15rem;
  }
  .rdv-lieu {
    font-family: "Barlow Semi Condensed", sans-serif;
    font-size: var(--s0);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-2);
  }
</style>
