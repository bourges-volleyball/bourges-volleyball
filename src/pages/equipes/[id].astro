---
import Base from "../../layouts/Base.astro";
import { render } from "astro:content";
import { Image, getImage } from "astro:assets";
import { equipes, matchs, dateLongue, heure, finDuMatch } from "../../lib/donnees";

export async function getStaticPaths() {
  const liste = await equipes();
  return liste.map((e) => ({ params: { id: e.id }, props: { equipe: e } }));
}

const { equipe } = Astro.props;
const d = equipe.data;
// Partage sur les reseaux : JPEG de 1200 px au plus
const partage = d.photo && (await getImage({ src: d.photo, width: Math.min(1200, d.photo.width), format: "jpg" }));
// Une photo plus haute que le 4:3 (presque carree) est un peu recadree en
// largeur : on perd du plafond et du sol, pas les joueurs. Une photo deja
// large reste entiere.
const recadree = d.photo && d.photo.width / d.photo.height < 4 / 3;

/* Texte libre de la fiche. Sert par exemple a detailler les equipes
   engagees quand un groupe en aligne plusieurs. Vide, rien ne s'affiche. */
const { Content } = await render(equipe);
const aDuTexte = equipe.body !== undefined && equipe.body.trim().length > 0;

/* Les rencontres de cette equipe, tirees du meme flux que le calendrier :
   la fiche reste juste sans que personne la mette a jour. */
const { aVenir, joues } = await matchs();
const sien = (m: { data: { equipe: string } }) => m.data.equipe === d.nom;
const prochaines = aVenir.filter(sien).slice(0, 6);
const derniers = joues.filter(sien).slice(0, 3);
---

<Base
  titre={d.nom}
  description={`${d.nom} du Bourges Volley-Ball : ${d.niveau}, créneaux, gymnase et effectif.`}
  image={partage?.src}
>
  {/* Une photo d'equipe ne se recadre pas en bandeau : on perdait les tetes
      ou le premier rang. Elle s'affiche presque entiere, sur un fond flou tire
      d'elle-meme, et les infos de l'equipe occupent la colonne d'a cote. */}
  <section class:list={["entete", { "avec-photo": d.photo }]}>
    {d.photo && <Image class="fond" src={d.photo} alt="" widths={[480]} sizes="100vw" loading="eager" />}
    <span class="voile" aria-hidden="true"></span>
    <div class="wrap entete-in">
      <div class="titre">
        <p class="niveau">{d.niveau}</p>
        <h1>{d.nom}</h1>
        <p class="ages">
          De {d.ageMin} à {d.ageMax === 99 ? "99" : d.ageMax} ans
        </p>
      </div>
      {d.photo && (
        <Image
          class:list={["photo", { recadree }]}
          src={d.photo}
          alt={`L’équipe ${d.nom}`}
          widths={[480, 720, 960, 1280, 1600]}
          sizes="(min-width: 1000px) 58vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      )}
      <div class="infos">
        <dl class="faits">
          <div>
            <dt>Entraînements</dt>
            <dd>
              {d.creneaux.map((c) => (
                <span class="creneau">{c.jour} <b class="mono">{c.horaire}</b></span>
              ))}
            </dd>
          </div>
          <div>
            <dt>Gymnase</dt>
            <dd>{d.gymnase}</dd>
          </div>
          {/* Pas d'encadrant renseigne : on masque la ligne plutot que
              d'afficher un « À préciser » qui fait inacheve. */}
          {d.coach && (
            <div>
              <dt>Encadrement</dt>
              <dd>{d.coach}</dd>
            </div>
          )}
          <div>
            <dt>Saison complète</dt>
            <dd>{d.tarif} €<span class="precision">licence et assurance comprises</span></dd>
          </div>
        </dl>
        <a class="btn" href={`/nous-rejoindre/?age=${d.ageMin}#resultats`}>
          <span>Essayer cette équipe</span>
        </a>
      </div>
    </div>
  </section>

  {
    aDuTexte && (
      <section class="section wrap">
        <div class="presentation"><Content /></div>
      </section>
    )
  }

  {
    d.effectif && d.effectif.length > 0 && (
      <section class="section wrap">
        <div class="section-head">
          <h2>L’effectif</h2>
          <span class="compte">{d.effectif.length} joueurs</span>
        </div>
        <ul class="effectif">
          {d.effectif.map((j) => (
            <li>
              {j.numero !== undefined && <span class="numero mono">{j.numero}</span>}
              <span class="nom">{j.nom}</span>
              {j.poste && <span class="poste">{j.poste}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    (prochaines.length > 0 || derniers.length > 0) && (
      <section class="section wrap">
        <div class="section-head">
          <h2>Ses rencontres</h2>
          <a class="lien" href="/matchs/">Tout le calendrier</a>
        </div>
        <div class="deux">
          <div>
            <p class="eyebrow">À venir</p>
            <ul class="rencontres" data-max="3">
              {prochaines.length === 0 ? (
                <li class="rien">Aucune rencontre programmée.</li>
              ) : (
                prochaines.map((m) => (
                  <li data-jusqua={finDuMatch(m.data.date).toISOString()}>
                    <span class="quand">
                      {dateLongue(m.data.date)} <b class="mono">{heure(m.data.date)}</b>
                    </span>
                    <span class="qui">
                      {m.data.domicile
                        ? `Bourges VB — ${m.data.adversaire}`
                        : `${m.data.adversaire} — Bourges VB`}
                    </span>
                  </li>
                ))
              )}
            </ul>
          </div>
          <div>
            <p class="eyebrow">Derniers résultats</p>
            <ul class="rencontres">
              {derniers.length === 0 ? (
                <li class="rien">Pas encore de rencontre jouée.</li>
              ) : (
                derniers.map((m) => (
                  <li>
                    <span class="quand">{dateLongue(m.data.date)}</span>
                    <span class="qui">
                      {m.data.domicile
                        ? `Bourges VB — ${m.data.adversaire}`
                        : `${m.data.adversaire} — Bourges VB`}
                      <b class="score">
                        {m.data.domicile
                          ? `${m.data.scoreNous} — ${m.data.scoreEux}`
                          : `${m.data.scoreEux} — ${m.data.scoreNous}`}
                      </b>
                    </span>
                  </li>
                ))
              )}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <section class="section wrap retour">
    <a class="lien" href="/equipes/">Toutes les équipes</a>
  </section>
</Base>

<style>
  .presentation { max-width: 68ch; font-size: var(--s2); }
  .presentation :global(h2) { font-size: 1.9rem; margin-bottom: 0.6rem; }
  .presentation :global(h3) { font-size: 1.35rem; margin-top: 1.6rem; }
  .presentation :global(p) { margin: 1rem 0; color: var(--fg-2); }
  .presentation :global(ul) { padding-left: 1.2rem; color: var(--fg-2); }
  .presentation :global(li) { margin: 0.4rem 0; }
  .presentation :global(strong) { color: var(--fg); }
  .presentation :global(a) { color: var(--signal); }

  .entete { position: relative; overflow: hidden; min-height: clamp(240px, 38vh, 380px); display: grid; align-items: end; }
  /* Le fond n'est qu'une ambiance : la photo floutee et assombrie. Agrandie
     un peu pour que le flou ne laisse pas de bord clair. */
  .fond { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: blur(28px) brightness(0.42) saturate(0.8); transform: scale(1.15); }
  .voile { position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(9,10,13,0.95) 0%, rgba(9,10,13,0.6) 45%, rgba(9,10,13,0.2) 100%); }
  /* Sur telephone : titre, photo, puis les infos. Sur ordinateur : la photo
     a droite, le titre en haut a gauche et les infos en bas a gauche. */
  .entete-in { position: relative; padding-block: clamp(1.75rem, 5vw, 3rem); width: 100%;
    display: grid; gap: clamp(1.25rem, 3vw, 2.25rem); grid-template-areas: "titre" "photo" "infos"; }
  .titre { grid-area: titre; }
  .infos { grid-area: infos; display: grid; justify-items: start; }
  @media (min-width: 1000px) {
    .avec-photo .entete-in {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: "titre photo" "infos photo";
      column-gap: clamp(2rem, 4vw, 3.5rem);
    }
    .avec-photo .infos { align-self: end; }
    .avec-photo .faits { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* Toute la photo, a ses proportions : ni recadree ni deformee */
  .photo { grid-area: photo; display: block; width: auto; height: auto; max-width: 100%; max-height: min(72vh, 600px);
    justify-self: end; align-self: start; border: 1px solid var(--hair); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45); }
  @media (max-width: 999px) { .photo { justify-self: center; max-height: 80vh; } }
  /* 60 % : on garde un peu plus le bas (les pieds du premier rang) que le
     haut, ou il n'y a souvent que le plafond */
  .photo.recadree { width: 100%; max-height: none; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 60%; }
  .niveau { margin: 0 0 0.4rem; font-family: "Barlow Semi Condensed", sans-serif; font-weight: 600;
    font-size: var(--s0); letter-spacing: 0.16em; text-transform: uppercase; color: var(--signal); }
  .entete h1 { font-size: clamp(2.4rem, 8vw, 5rem); }
  .ages { margin: 0.6rem 0 0; color: var(--fg-2);
    font-family: "Barlow Semi Condensed", sans-serif; letter-spacing: 0.08em; text-transform: uppercase; font-size: var(--s0); }

  .faits { margin: 0 0 1.5rem; display: grid; gap: 1.4rem; width: 100%;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); }
  dt { font-family: "Barlow Semi Condensed", sans-serif; font-size: var(--s0);
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-2); margin-bottom: 0.35rem; }
  dd { margin: 0; font-weight: 600; font-size: var(--s2); line-height: 1.35; }
  .creneau { display: block; font-weight: 500; }
  .creneau b { white-space: nowrap; }
  .precision { display: block; font-family: "Barlow Semi Condensed", sans-serif;
    font-weight: 400; font-size: var(--s1); color: var(--fg-2); }

  .compte { font-family: "Barlow Semi Condensed", sans-serif; font-size: var(--s0);
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-2); }
  .effectif { list-style: none; padding: 0; margin: 0; display: grid; gap: 1px; background: var(--hair);
    border: 1px solid var(--hair); }
  @media (min-width: 640px) { .effectif { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .effectif { grid-template-columns: repeat(3, 1fr); } }
  .effectif li { background: var(--noir-2); padding: 0.75rem 1rem; display: flex;
    align-items: baseline; gap: 0.75rem; }
  .numero { font-family: "Barlow Condensed", sans-serif; font-weight: 800; font-size: 1.4rem;
    color: var(--fg-2); min-width: 1.6rem; font-variant-numeric: tabular-nums; }
  .nom { font-weight: 600; margin-right: auto; }
  .poste { font-family: "Barlow Semi Condensed", sans-serif; font-size: 0.7rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-2); text-align: right; }

  .deux { display: grid; gap: clamp(1.5rem, 4vw, 2.5rem); }
  @media (min-width: 860px) { .deux { grid-template-columns: 1fr 1fr; } }
  .rencontres { list-style: none; padding: 0; margin: 0.75rem 0 0; display: grid; }
  .rencontres li { padding: 0.7rem 0; border-top: 1px solid var(--hair); display: grid; gap: 0.15rem; }
  .rencontres li:first-child { border-top: 2px solid var(--structure); }
  .quand { font-family: "Barlow Semi Condensed", sans-serif; font-size: var(--s0);
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-2); }
  .qui { font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em; display: flex; gap: 0.75rem; align-items: baseline; }
  .score { margin-left: auto; font-family: "Barlow Condensed", sans-serif; font-size: 1.25rem;
    font-variant-numeric: tabular-nums; }
  .rien { color: var(--fg-2); font-weight: 400; border-top: 1px solid var(--hair); }
  .retour { border-top: 1px solid var(--hair); }
</style>
