---
import Base from "../../layouts/Base.astro";
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import { RAYONS, dateLongue, euros, venteOuverte } from "../../lib/donnees";

export async function getStaticPaths() {
  return (await getCollection("boutique")).map((c) => ({ params: { id: c.id }, props: { c } }));
}

const { c } = Astro.props;
const d = c.data;
const rayon = RAYONS.find((r) => r.id === d.categorie)!;
const ouverte = venteOuverte(d);
const pasEncore = d.ouvertureLe && d.ouvertureLe.getTime() > Date.now();
// Version agrandie des photos, ouverte d'un clic : jamais plus grande que l'original
const grandes = await Promise.all(
  d.articles.map((a) => a.photo && getImage({ src: a.photo, width: Math.min(1200, a.photo.width), format: "webp" })),
);

/* Ce dont le script a besoin pour poser les questions et afficher le total.
   Les prix ne servent qu'a l'affichage : le serveur recalcule tout. */
const jourIso = (j: Date) => j.toISOString().slice(0, 10);
const enClair = (j: Date) => j.toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long", timeZone: "UTC" });
const detailOption = (o: { parJour: boolean; offerteDes?: number; jour?: Date }) =>
  (o.parJour ? " par jour" : "") +
  (o.jour ? ` le ${enClair(o.jour)}` : "") +
  (o.offerteDes ? `, offerte pour ${o.offerteDes} jours` : "");

const vente = {
  id: c.id,
  nominatif: d.nominatif,
  qui: d.categorie === "adhesion" ? "Nom et prénom de l’adhérent" : "Nom et prénom du participant",
  questions: d.questions,
  ouvertureLe: d.ouvertureLe?.toISOString(),
  fermetureLe: d.fermetureLe?.toISOString(),
  articles: d.articles.map((a) => ({
    nom: a.nom,
    prix: a.prix,
    tailles: a.tailles ?? [],
    jours: a.jours.map(jourIso),
    options: a.options.map((o) => ({
      nom: o.nom,
      prix: o.prix,
      parJour: o.parJour,
      offerteDes: o.offerteDes,
      jour: o.jour && jourIso(o.jour),
      detail: detailOption(o),
    })),
  })),
};
---

<Base titre={d.nom} description={d.description}>
  <section class="page-head wrap">
    <p class="eyebrow"><a href={`/boutique/#${d.categorie}`}>Boutique · {rayon.titre}</a></p>
    <h1>{d.nom}</h1>
    <p>{d.description}</p>
    {
      (d.quand || d.lieu || d.fermetureLe) && (
        <dl class="infos">
          {d.quand && (
            <div>
              <dt>Quand</dt>
              <dd>{d.quand}</dd>
            </div>
          )}
          {d.lieu && (
            <div>
              <dt>Où</dt>
              <dd>{d.lieu}</dd>
            </div>
          )}
          {d.fermetureLe && (
            <div>
              <dt>Commandes jusqu’au</dt>
              <dd>{dateLongue(d.fermetureLe)}</dd>
            </div>
          )}
        </dl>
      )
    }
  </section>

  <section class="section wrap">
    <div class="ferme" data-ferme hidden={ouverte}>
      <h2>{pasEncore ? `Ouverture le ${dateLongue(d.ouvertureLe!)}` : "Cette vente est fermée"}</h2>
      <a class="btn ghost" href="/boutique/"><span>Voir les autres ventes</span></a>
    </div>

    <form class="commande" data-vente={JSON.stringify(vente)} hidden={!ouverte}>
      <fieldset>
        <legend><h2>{d.nominatif ? "Choisissez vos places" : "Choisissez vos articles"}</h2></legend>
        <ul class="articles">
          {
            d.articles.map((a, i) => (
              <li class="article">
                {a.photo && (
                  <button type="button" class="loupe" data-grande={grandes[i] && grandes[i].src} data-legende={a.nom} aria-label={`Agrandir la photo : ${a.nom}`}>
                    <Image class="photo" src={a.photo} alt="" widths={[80, 160]} sizes="80px" />
                  </button>
                )}
                <div class="texte">
                  <h3>{a.nom}</h3>
                  {a.description && <p>{a.description}</p>}
                  {a.tailles?.length ? <p class="tailles">Tailles : {a.tailles.join(" · ")}</p> : null}
                  {a.options.length > 0 && (
                    <p class="tailles">
                      En option : {a.options.map((o) => `${o.nom} ${euros(o.prix)}${detailOption(o)}`).join(" · ")}
                    </p>
                  )}
                  {a.jours.length > 0 && (
                    <p>Ajoutez chaque participant avec +, puis cochez ses jours{a.options.length > 0 && " et ses options"}.</p>
                  )}
                  <p class="places" data-places={i} hidden />
                </div>
                <p class="prix">{euros(a.prix)}{a.jours.length > 0 && <small> / jour</small>}</p>
                <div class="qte">
                  <button type="button" data-moins={i} aria-label={`Retirer : ${a.nom}`}>−</button>
                  <input type="number" min="0" max="20" value="0" inputmode="numeric" data-qte={i} aria-label={`${a.jours.length ? "Nombre de participants" : "Quantité"} : ${a.nom}`} />
                  <button type="button" data-plus={i} aria-label={`Ajouter : ${a.nom}`}>+</button>
                </div>
                {/* Taille, nom du participant : demandes ici, sous l'article, des qu'on l'ajoute */}
                <div class="unites" data-unites-de={i}></div>
              </li>
            ))
          }
        </ul>
      </fieldset>

      <fieldset>
        <legend><h2>Vos coordonnées</h2></legend>
        <div class="champs">
          <p>
            <label for="prenom">Prénom</label>
            <input id="prenom" name="prenom" required maxlength="50" autocomplete="given-name" />
          </p>
          <p>
            <label for="nom">Nom</label>
            <input id="nom" name="nom" required maxlength="50" autocomplete="family-name" />
          </p>
          <p class="large">
            <label for="email">Adresse mail</label>
            <input id="email" name="email" type="email" required maxlength="80" autocomplete="email" />
          </p>
        </div>
        <p class="aide">HelloAsso vous envoie le reçu de paiement à cette adresse.</p>
      </fieldset>

      <div class="payer">
        <p class="total">Total <strong data-total>0 €</strong></p>
        <p class="erreur" role="alert" data-erreur hidden></p>
        <button class="btn" type="submit" data-payer disabled><span>Payer avec HelloAsso</span></button>
        <p class="note">
          Vous allez être redirigé vers HelloAsso pour payer par carte. HelloAsso
          vous propose une contribution volontaire à son fonctionnement : elle est
          modifiable et peut être ramenée à zéro. Le club conserve votre commande
          un an (<a href="/confidentialite/">vos données</a>).
        </p>
      </div>
    </form>

    <dialog class="visionneuse" data-visionneuse aria-label="Photo agrandie">
      <img alt="" />
      <p></p>
      <button type="button" class="btn ghost"><span>Fermer</span></button>
    </dialog>
  </section>
</Base>

<script>
  type Vente = {
    id: string;
    nominatif: boolean;
    qui: string;
    questions: { libelle: string; type: "texte" | "ouinon" }[];
    ouvertureLe?: string;
    fermetureLe?: string;
    articles: {
      nom: string;
      prix: number;
      tailles: string[];
      jours: string[];
      options: { nom: string; prix: number; parJour: boolean; offerteDes?: number; jour?: string; detail: string }[];
    }[];
  };

  const form = document.querySelector<HTMLFormElement>("form[data-vente]");
  if (form) {
    const vente: Vente = JSON.parse(form.dataset.vente!);
    const qtes = [...form.querySelectorAll<HTMLInputElement>("[data-qte]")];
    const erreur = form.querySelector<HTMLElement>("[data-erreur]")!;
    const payer = form.querySelector<HTMLButtonElement>("[data-payer]")!;
    const enEuros = new Intl.NumberFormat("fr-FR", { style: "currency", currency: "EUR" });

    // La page est construite a l'avance : les dates sont reverifiees ici
    const maintenant = Date.now();
    if (
      (vente.ouvertureLe && Date.parse(vente.ouvertureLe) > maintenant) ||
      (vente.fermetureLe && Date.parse(vente.fermetureLe) + 86400000 <= maintenant)
    ) {
      form.hidden = true;
      document.querySelector<HTMLElement>("[data-ferme]")!.hidden = false;
    }

    const qte = (i: number) => {
      const n = Math.floor(Number(qtes[i].value));
      return n > 0 ? Math.min(n, Number(qtes[i].max)) : 0;
    };
    const champ = (nom: string) =>
      (form.elements.namedItem(nom) as HTMLInputElement | RadioNodeList | null)?.value ?? "";
    const coche = (nom: string) => !!(form.elements.namedItem(nom) as HTMLInputElement | null)?.checked;
    const centimes = (p: number) => Math.round(p * 100);

    // Stage : jours en AAAA-MM-JJ. Pas de fermeture jour par jour : la vente
    // entiere se ferme a sa date de fermeture, avant le stage.
    const court = (j: string) => new Date(j).toLocaleDateString("fr-FR", { weekday: "short", day: "numeric", timeZone: "UTC" });
    const joursCoches = (a: Vente["articles"][number], nom: string) => a.jours.filter((_, n) => coche(`${nom}-j${n}`));
    // Places restantes, une fois connues ; pour un stage, une par jour (cleJour dans netlify/lib/boutique.mjs)
    const restantes: Record<string, number> = {};
    const cleJour = (article: string, jour: string) => `${article} / ${jour}`;

    /* Total affiche, meme calcul que verifier() dans netlify/lib/boutique.mjs,
       qui seul fait foi : pour chaque personne, ses jours et ses options. */
    function calculer() {
      let total = 0;
      vente.articles.forEach((a, i) => {
        for (let k = 0; k < qte(i); k++) {
          const nom = `a${i}-${k}`;
          const coches = a.jours.length ? joursCoches(a, nom) : [];
          const j = a.jours.length ? coches.length : 1;
          total += centimes(a.prix) * j;
          a.options.forEach((o, m) => {
            const c = form!.elements.namedItem(`${nom}-opt${m}`) as HTMLInputElement | null;
            // Une sortie liee a un jour ne se coche que si ce jour l'est
            if (c && o.jour) {
              c.disabled = !coches.includes(o.jour);
              if (c.disabled) c.checked = false;
            }
            if (!c?.checked || (o.offerteDes && j >= o.offerteDes)) return;
            total += centimes(o.prix) * (o.parJour ? j : 1);
          });
        }
      });
      form!.querySelector("[data-total]")!.textContent = enEuros.format(total / 100);
      payer.disabled = total === 0;
    }

    function el<K extends keyof HTMLElementTagNameMap>(
      tag: K,
      props: Partial<HTMLElementTagNameMap[K]> = {},
      ...enfants: (Node | string)[]
    ) {
      const e = Object.assign(document.createElement(tag), props);
      e.append(...enfants);
      return e;
    }
    const ligne = (libelle: string, controle: HTMLInputElement | HTMLSelectElement) =>
      el("p", {}, el("label", { htmlFor: controle.id, textContent: libelle }), controle);

    /* Sous chaque article ajoute, une case par exemplaire : sa taille, le
       nom de la personne, les questions de la vente. Redessine a chaque
       changement de quantite, en gardant ce qui etait deja saisi. */
    function dessiner() {
      const saisi = new Map<string, string>();
      form!.querySelectorAll<HTMLInputElement | HTMLSelectElement>(".unites input, .unites select").forEach((c) => {
        const aCocher = c.type === "radio" || c.type === "checkbox";
        if (!aCocher || (c as HTMLInputElement).checked) saisi.set(c.name, c.value);
      });

      vente.articles.forEach((a, i) => {
        const n = qte(i);
        const unites = form!.querySelector<HTMLElement>(`[data-unites-de="${i}"]`)!;
        unites.replaceChildren();
        if (!a.tailles.length && !vente.nominatif && !a.jours.length && !a.options.length) return;

        for (let k = 0; k < n; k++) {
          const nom = `a${i}-${k}`;
          const bloc = el("fieldset", { className: "unite" });
          if (n > 1) bloc.append(el("legend", { textContent: `${k + 1} sur ${n}` }));
          if (a.tailles.length) {
            const s = el(
              "select",
              { id: `${nom}-taille`, name: `${nom}-taille`, required: true },
              el("option", { value: "", textContent: "Choisir…" }),
              ...a.tailles.map((t) => el("option", { value: t, textContent: t })),
            );
            s.value = saisi.get(s.name) ?? "";
            bloc.append(ligne("Taille", s));
          }
          if (vente.nominatif) {
            const qui = el("input", { id: `${nom}-qui`, name: `${nom}-qui`, required: true, maxLength: 100 });
            qui.value = saisi.get(qui.name) ?? "";
            bloc.append(ligne(vente.qui, qui));
          }
          // Stage : d'abord le nom, puis ses jours et ses options, puis les questions
          if (a.jours.length) {
            const cases = a.jours.map((j, n) => {
              const complet = restantes[cleJour(a.nom, j)] === 0;
              const c = el("input", { type: "checkbox", name: `${nom}-j${n}`, value: j, disabled: complet });
              c.checked = !c.disabled && saisi.has(c.name);
              return el("label", { className: "choix" }, c, court(j) + (complet ? " (complet)" : ""));
            });
            bloc.append(el("fieldset", { className: "ouinon" }, el("legend", { textContent: "Jours" }), ...cases));
          }
          a.options.forEach((o, m) => {
            const c = el("input", { type: "checkbox", name: `${nom}-opt${m}`, value: o.nom });
            c.checked = saisi.has(c.name);
            bloc.append(el("label", { className: "choix" }, c, `${o.nom} (${enEuros.format(o.prix)}${o.detail})`));
          });
          if (vente.nominatif) {
            vente.questions.forEach((q, j) => {
              const nq = `${nom}-q${j}`;
              if (q.type === "ouinon") {
                const choix = ["Oui", "Non"].map((v) => {
                  const r = el("input", { type: "radio", name: nq, value: v, required: true });
                  r.checked = saisi.get(nq) === v;
                  return el("label", { className: "choix" }, r, v);
                });
                bloc.append(el("fieldset", { className: "ouinon" }, el("legend", { textContent: q.libelle }), ...choix));
              } else {
                const t = el("input", { id: nq, name: nq, required: true, maxLength: 250 });
                t.value = saisi.get(nq) ?? "";
                bloc.append(ligne(q.libelle, t));
              }
            });
          }
          unites.append(bloc);
        }
      });

      calculer();
    }

    form.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-plus], [data-moins]");
      if (!b) return;
      const i = Number(b.dataset.plus ?? b.dataset.moins);
      const n = qte(i) + (b.dataset.plus !== undefined ? 1 : -1);
      qtes[i].value = String(Math.max(0, Math.min(Number(qtes[i].max), n)));
      dessiner();
    });
    form.addEventListener("input", (e) => {
      if ((e.target as HTMLElement).matches("[data-qte]")) dessiner();
      else if ((e.target as HTMLElement).closest(".unites")) calculer();
    });

    // Places restantes (stage, tournoi) : connues du serveur seul
    fetch(`/.netlify/functions/commande?campagne=${encodeURIComponent(vente.id)}`)
      .then((r) => (r.ok ? r.json() : {}))
      .then((r: Record<string, number>) => {
        Object.assign(restantes, r);
        vente.articles.forEach((a, i) => {
          const info = form.querySelector<HTMLElement>(`[data-places="${i}"]`)!;
          const fermer = (oui: boolean) => {
            qtes[i].disabled = oui;
            form.querySelector<HTMLButtonElement>(`[data-plus="${i}"]`)!.disabled = oui;
          };
          if (a.jours.length) {
            const connus = a.jours.filter((j) => restantes[cleJour(a.nom, j)] !== undefined);
            if (!connus.length) return;
            info.hidden = false;
            info.textContent =
              "Places restantes : " + connus.map((j) => `${court(j)} : ${restantes[cleJour(a.nom, j)] || "complet"}`).join(" · ");
            fermer(connus.every((j) => restantes[cleJour(a.nom, j)] === 0));
            return;
          }
          const reste = restantes[a.nom];
          if (reste === undefined) return;
          info.hidden = false;
          info.textContent = reste === 0 ? "Complet" : `${reste} place${reste > 1 ? "s" : ""} restante${reste > 1 ? "s" : ""}`;
          qtes[i].max = String(Math.min(20, reste));
          fermer(reste === 0);
        });
        dessiner();
      })
      .catch(() => {});

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      erreur.hidden = true;

      const lignes = vente.articles.flatMap((a, i) => {
        const n = qte(i);
        if (!n) return [];
        const details = Array.from({ length: n }, (_, k) => ({
          taille: champ(`a${i}-${k}-taille`) || undefined,
          participant: champ(`a${i}-${k}-qui`) || undefined,
          reponses: Object.fromEntries(vente.questions.map((q, j) => [q.libelle, champ(`a${i}-${k}-q${j}`)])),
          jours: a.jours.length ? joursCoches(a, `a${i}-${k}`) : undefined,
          options: a.options.filter((_, m) => coche(`a${i}-${k}-opt${m}`)).map((o) => o.nom),
        }));
        return [{ article: a.nom, quantite: n, details }];
      });

      const libelle = payer.firstElementChild!;
      payer.disabled = true;
      libelle.textContent = "Redirection vers HelloAsso…";
      let message = "La commande n’a pas pu être envoyée. Vérifiez votre connexion et réessayez.";
      try {
        const r = await fetch("/.netlify/functions/commande", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            campagne: vente.id,
            payeur: { prenom: champ("prenom"), nom: champ("nom"), email: champ("email") },
            lignes,
          }),
        });
        const j = await r.json();
        if (typeof j.url === "string" && j.url.startsWith("https://")) return location.assign(j.url);
        if (j.erreur) message = j.erreur;
      } catch {}
      erreur.textContent = message;
      erreur.hidden = false;
      payer.disabled = false;
      libelle.textContent = "Payer avec HelloAsso";
    });

    dessiner();
  }

  // Photo d'un article en grand : <dialog> natif (Echap, clic, bouton ferment)
  const visionneuse = document.querySelector<HTMLDialogElement>("[data-visionneuse]");
  if (visionneuse) {
    document.querySelectorAll<HTMLButtonElement>(".loupe").forEach((b) =>
      b.addEventListener("click", () => {
        const img = visionneuse.querySelector("img")!;
        img.src = b.dataset.grande!;
        img.alt = b.dataset.legende!;
        visionneuse.querySelector("p")!.textContent = b.dataset.legende!;
        visionneuse.showModal();
      }),
    );
    visionneuse.addEventListener("click", () => visionneuse.close());
  }
</script>

<style>
  .eyebrow a { color: inherit; text-decoration: none; }
  .eyebrow a:hover { color: var(--signal); }
  .infos { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; margin: 1.5rem 0 0; }
  .infos dt {
    font-family: "Barlow Semi Condensed", sans-serif;
    font-size: var(--s0);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-2);
    margin-bottom: 0.2rem;
  }
  .infos dd { margin: 0; font-weight: 600; }

  .ferme {
    background: var(--noir-2);
    border: 1px solid var(--hair);
    border-left: 4px solid var(--signal);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .ferme[hidden] { display: none; }

  .commande { display: grid; gap: clamp(2rem, 5vw, 3rem); max-width: 860px; }
  .commande[hidden] { display: none; }
  /* :global : les cases de precision sont creees par le script, sans
     l'attribut qu'Astro ajoute pour limiter les styles a cette page */
  .commande :global(fieldset) { border: 0; padding: 0; margin: 0; min-width: 0; }
  .commande :global(fieldset[hidden]) { display: none; }
  .commande :global(legend) { padding: 0; }
  .commande legend h2 { font-size: clamp(1.6rem, 4vw, 2.2rem); margin-bottom: 1rem; }
  .commande :global(p) { margin: 0; }

  .articles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1px;
    background: var(--hair);
    border: 1px solid var(--hair);
  }
  .article {
    background: var(--noir-2);
    padding: 0.9rem 1rem;
    display: grid;
    gap: 0.6rem 1rem;
    align-items: center;
    grid-template-columns: 1fr auto;
    grid-template-areas: "texte texte" "prix qte" "unites unites";
  }
  .article:has(.loupe) {
    grid-template-columns: 72px 1fr auto;
    grid-template-areas: "photo texte texte" "photo prix qte" "unites unites unites";
  }
  @media (min-width: 640px) {
    .article { grid-template-columns: 1fr auto auto; grid-template-areas: "texte prix qte" "unites unites unites"; }
    .article:has(.loupe) {
      grid-template-columns: 88px 1fr auto auto;
      grid-template-areas: "photo texte prix qte" "unites unites unites unites";
    }
  }
  /* La photo est un bouton : un clic l'ouvre en grand */
  .loupe {
    grid-area: photo;
    position: relative;
    padding: 0;
    border: 1px solid var(--hair);
    background: #fff;
    cursor: zoom-in;
    aspect-ratio: 1;
  }
  .loupe:hover { border-color: var(--signal); }
  .loupe::after {
    content: "+";
    position: absolute;
    right: 0;
    bottom: 0;
    width: 1.3rem;
    height: 1.3rem;
    display: grid;
    place-items: center;
    background: var(--noir);
    color: var(--signal);
    font-weight: 800;
  }
  .photo { display: block; width: 100%; height: 100%; object-fit: contain; }
  .texte { grid-area: texte; }
  .texte h3 { font-size: 1.3rem; }
  .texte p { margin-top: 0.15rem; color: var(--fg-2); font-size: 0.9rem; }
  .texte .tailles { color: var(--fg); font-size: 0.85rem; letter-spacing: 0.04em; }
  .texte .places { color: var(--signal); font-weight: 600; }
  .texte .places[hidden] { display: none; }
  .prix small { font-size: 0.9rem; font-weight: 600; color: var(--fg-2); }
  .prix {
    grid-area: prix;
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 800;
    font-size: 1.35rem;
    white-space: nowrap;
  }
  .qte { grid-area: qte; justify-self: end; display: flex; }
  .qte button {
    width: 2.6rem;
    height: 2.6rem;
    background: var(--noir-3);
    color: var(--fg);
    border: 1px solid var(--hair);
    font-size: 1.25rem;
    cursor: pointer;
