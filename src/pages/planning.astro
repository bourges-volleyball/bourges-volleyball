---
import Base from "../layouts/Base.astro";
import { planning } from "../lib/donnees";

/* Tous les creneaux de la semaine. Rien a saisir ici : la page se construit
   avec les creneaux des fiches Equipes et ceux des ecoles de sport de la
   Ville (Textes des pages). */
const semaine = await planning();
---

<Base
  titre="Planning de la semaine"
  description="Tous les entraînements du Bourges Volley-Ball, jour par jour : horaires, catégories et gymnases, des M13 aux seniors et au loisir."
>
  <section class="page-head wrap">
    <p class="eyebrow">Chaque semaine</p>
    <h1>Planning</h1>
    <p>
      Tous les entraînements du club, jour par jour, et les écoles de sport de
      la Ville qui se déroulent avec lui. Un clic sur une équipe ouvre sa fiche.
    </p>
  </section>

  <section class="section wrap">
    <ol class="semaine">
      {
        semaine.map((j, i) => (
          <li class:list={["jour", { repos: !j.lignes.length }]} data-jour={i}>
            <h2>
              {j.jour}
              <span class="auj" hidden>Aujourd’hui</span>
            </h2>
            {j.lignes.length ? (
              <ul>
                {j.lignes.map((l) => (
                  <li class:list={["creneau", { ville: l.ville }]}>
                    <p class="heure mono">{l.horaire}</p>
                    <p class="qui">
                      {l.qui.map((q, k) => (
                        <>
                          {k > 0 && " · "}
                          <a href={q.href}>{q.nom}</a>
                        </>
                      ))}
                    </p>
                    <p class="pour">{l.pour}</p>
                    <p class="lieu">{l.lieu}</p>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="vide">Pas d’entraînement</p>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section wrap appel">
    <h2>Venir essayer</h2>
    <p>Deux séances d’essai gratuites, sur le créneau de votre choix, avant de prendre la licence.</p>
    <a class="btn" href="/nous-rejoindre/"><span>Nous rejoindre</span></a>
  </section>
</Base>

<script>
  // Page construite a l'avance : c'est le navigateur qui repere le jour
  const i = (new Date().getDay() + 6) % 7;
  const jour = document.querySelector<HTMLElement>(`.jour[data-jour="${i}"]`);
  if (jour) {
    jour.classList.add("aujourdhui");
    jour.querySelector<HTMLElement>(".auj")!.hidden = false;
  }
</script>

<style>
  .semaine {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 1px; background: var(--hair);
    border: 1px solid var(--hair);
  }
  /* Une colonne par jour sur grand ecran, comme un emploi du temps */
  @media (min-width: 1100px) { .semaine { grid-template-columns: repeat(7, minmax(0, 1fr)); } }

  .jour { background: var(--noir); padding: 1.1rem 1rem 1.3rem; display: grid; align-content: start; gap: 0.9rem; }
  .jour h2 {
    font-size: 1.35rem;
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.2rem 0.6rem;
  }
  .auj {
    font-family: "Barlow Semi Condensed", sans-serif;
    font-size: var(--s0); letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--sur-signal); background: var(--signal); padding: 0.1rem 0.45rem;
  }
  .auj[hidden] { display: none; }
  .aujourdhui { background: var(--noir-2); box-shadow: inset 0 3px 0 var(--signal); }

  .jour ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; }
  /* Telephone et tablette : les creneaux d'un jour cote a cote quand il y a la place */
  @media (min-width: 620px) and (max-width: 1099px) {
    .jour ul { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  }

  .creneau {
    background: var(--noir-2); border: 1px solid var(--hair); border-left: 3px solid var(--signal);
    padding: 0.7rem 0.8rem; display: grid; gap: 0.2rem;
  }
  .aujourdhui .creneau { background: var(--noir-3); }
  .creneau.ville { border-left-color: var(--fg-2); }
  .creneau p { margin: 0; }
  .heure { font-size: 1.05rem; font-weight: 600; color: var(--signal); }
  .ville .heure { color: var(--fg); }
  .qui { font-weight: 700; line-height: 1.25; }
  .qui a { text-decoration: none; }
  .qui a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .pour, .lieu { font-size: 0.85rem; color: var(--fg-2); line-height: 1.35; }

  .repos .vide { margin: 0; font-size: 0.9rem; color: var(--fg-2); }
  /* Telephone : un jour sans entrainement tient sur une ligne */
  @media (max-width: 1099px) {
    .repos { grid-template-columns: auto 1fr; align-items: baseline; gap: 1rem; }
  }

  .appel { border-top: 1px solid var(--hair); display: grid; gap: 0.9rem; justify-items: start; }
  .appel h2 { font-size: clamp(1.8rem, 5vw, 2.6rem); }
  .appel p { margin: 0; color: var(--fg-2); max-width: 60ch; }
</style>
