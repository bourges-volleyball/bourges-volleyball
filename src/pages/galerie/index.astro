---
/* Les albums photo, le plus recent en premier. Chaque carte montre la
   premiere photo de l'album en couverture. */
import Base from "../../layouts/Base.astro";
import { Image } from "astro:assets";
import { albums as lesAlbums, FUSEAU } from "../../lib/donnees";

const albums = await lesAlbums();
const quand = (d: Date) => d.toLocaleDateString("fr-FR", { month: "long", year: "numeric", timeZone: FUSEAU });
---

<Base titre="Galerie" description="Les photos du Bourges Volley-Ball : matchs, tournois, stages et vie du club.">
  <section class="page-head wrap">
    <p class="eyebrow">Vie du club</p>
    <h1>Galerie</h1>
  </section>

  <section class="section wrap">
    {
      albums.length === 0 ? (
        <p class="vide">Aucun album pour l&rsquo;instant. Les photos des matchs et des tournois arriveront ici.</p>
      ) : (
        <ul class="grille">
          {albums.map((a, i) => (
            <li>
              <a class="album" href={`/galerie/${a.id}/`}>
                <Image
                  class="couverture"
                  src={a.data.photos[0].photo}
                  alt=""
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 1100px) 33vw, (min-width: 640px) 50vw, 100vw"
                  loading={i < 3 ? "eager" : "lazy"}
                />
                <span class="texte">
                  <span class="date">{quand(a.data.date)} · {a.data.photos.length} photo{a.data.photos.length > 1 ? "s" : ""}</span>
                  <h2>{a.data.titre}</h2>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>

<style>
  .vide { color: var(--fg-2); font-size: var(--s2); margin: 0; }
  .grille {
    list-style: none; padding: 0; margin: 0; display: grid; gap: clamp(0.75rem, 2vw, 1.25rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  .album {
    position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; text-decoration: none;
    background: var(--noir-2); border: 1px solid var(--hair);
  }
  .couverture { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .album:hover .couverture { transform: scale(1.04); }
  .texte {
    position: absolute; inset: auto 0 0 0; padding: 2.5rem 1rem 1rem; display: grid; gap: 0.3rem;
    background: linear-gradient(to top, rgba(9, 10, 13, 0.92), rgba(9, 10, 13, 0));
  }
  .date {
    font-family: "Barlow Semi Condensed", sans-serif; font-weight: 600; font-size: var(--s0);
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--signal);
  }
  .album h2 { font-size: clamp(1.4rem, 3vw, 1.8rem); }
</style>
